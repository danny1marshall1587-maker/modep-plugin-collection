@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix dg:    <http://www.darkglass.com/lv2/ns#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pg:    <http://lv2plug.in/ns/ext/port-groups#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rsz:   <http://lv2plug.in/ns/ext/resize-port#> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix unit:  <http://lv2plug.in/ns/extensions/units#> .

<urn:hvcc:Dimension_IV>
    a lv2:Plugin, lv2:SpatialPlugin, doap:Project ;

    lv2:extensionData opts:interface ;

    lv2:optionalFeature <http://lv2plug.in/ns/lv2core#hardRTCapable> ,
                        <http://lv2plug.in/ns/ext/buf-size#boundedBlockLength> ;

    lv2:requiredFeature opts:options ,
                        <http://lv2plug.in/ns/ext/urid#map> ;

    opts:supportedOption <http://lv2plug.in/ns/ext/buf-size#nominalBlockLength> ,
                         <http://lv2plug.in/ns/ext/buf-size#maxBlockLength> ,
                         <http://lv2plug.in/ns/ext/parameters#sampleRate> ;

    lv2:port [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "lv2_audio_in_1" ;
        lv2:name "Audio Input 1" ;
    ] ,
    [
        a lv2:InputPort, lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "lv2_audio_in_2" ;
        lv2:name "Audio Input 2" ;
    ] ;

    lv2:port [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "lv2_audio_out_1" ;
        lv2:name "Audio Output 1" ;
    ] ,
    [
        a lv2:OutputPort, lv2:AudioPort ;
        lv2:index 3 ;
        lv2:symbol "lv2_audio_out_2" ;
        lv2:name "Audio Output 2" ;
    ] ;

    lv2:port [
        a lv2:InputPort, atom:AtomPort ;
        lv2:index 4 ;
        lv2:name "Events Input" ;
        lv2:symbol "lv2_events_in" ;
        rsz:minimumSize 2048 ;
        atom:bufferType atom:Sequence ;
        atom:supports <http://lv2plug.in/ns/ext/time#Position> ;
    ] ;
    lv2:port [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 5 ;
        lv2:name "Antiphase" ;
        lv2:symbol "antiphase" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:enumeration, lv2:integer;
        lv2:scalePoint [
            rdf:value 0 ;
            rdfs:label "Off" ;
            rdfs:comment "Off" ;
        ], [
            rdf:value 1 ;
            rdfs:label "Normal" ;
            rdfs:comment "Normal" ;
        ], [
            rdf:value 2 ;
            rdfs:label "Max" ;
            rdfs:comment "Max" ;
        ];
    ] ,
    [
        a lv2:InputPort, lv2:ControlPort ;
        lv2:index 6 ;
        lv2:name "Dimension" ;
        lv2:symbol "dimension" ;
	 lv2:default 1 ;
        lv2:minimum 1 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:enumeration, lv2:integer;
        lv2:scalePoint [
            rdf:value 1 ;
            rdfs:label "I" ;
            rdfs:comment "I" ;
        ], [
            rdf:value 2 ;
            rdfs:label "II" ;
            rdfs:comment "II" ;
        ], [
            rdf:value 3 ;
            rdfs:label "III" ;
            rdfs:comment "III" ;
        ], [
            rdf:value 4 ;
            rdfs:label "IV" ;
            rdfs:comment "IV" ;
        ];
    ] ;

    rdfs:comment "Modeled after the ubiquitous stereo spatializing pushbutton studio effect from 1979 heard on everything from the Cocteau Twins to Stevie Ray Vaughan.  Not a digital pitchshifter, but two analog BBD delay lines in true stereo modulating short delays in opposing directions.  The chorused signal is filtered and mixed back into its corresponding dry channel along with a phase flipped copy of the other channel to produce its distinctive 'stereoizing' effect.  While the look of this plugin is the Dimension C, the sound is Dimension D." ;

    mod:brand "Mondomatic" ;
    mod:label "Dimension IV" ;

    doap:name "Dimension IV" ;
    doap:license <http://spdx.org/licenses/ISC.html> ;

    doap:maintainer [
		foaf:name "Jim Auge'" ;
		foaf:homepage <https://websites.umich.edu/~jauge/dimensioniv/> ;		
    ] ;

    lv2:microVersion 0 ;
    lv2:minorVersion 1 .
