@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<urn:brummer:bluesbreaker>
    a lv2:Plugin ,
      lv2:DistortionPlugin ;
    doap:name "Bluesbreaker" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "Brummer" ;
    mod:label "Bluesbreaker" ;
    rdfs:comment "Authentic simulation of the classic vintage Marshall Bluesbreaker (BB-1) low-gain overdrive pedal with smooth diode feedback soft-clipping, transparent frequency response, and dynamic touch sensitivity." ;
    
    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "BYPASS" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "GAIN" ;
        lv2:name "Gain" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "TONE" ;
        lv2:name "Tone" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "VOLUME" ;
        lv2:name "Volume" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] .
