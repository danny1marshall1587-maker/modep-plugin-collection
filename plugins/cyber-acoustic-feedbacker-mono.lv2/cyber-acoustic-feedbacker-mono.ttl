@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://cyber-audio.co.uk/plugins/cyber-acoustic-feedbacker-mono>
    a lv2:Plugin ,
      lv2:GeneratorPlugin ;
    doap:name "Cyber Acoustic Feedbacker Mono" ;
    doap:license <http://opensource.org/licenses/mit> ;
    doap:developer [
        foaf:name "Cyber Audio" ;
        foaf:homepage <http://cyber-audio.co.uk> ;
    ] ;
    lv2:minorVersion 4 ;
    lv2:microVersion 0 ;
    mod:brand "CyberAudio" ;
    mod:label "Feedbacker Mono" ;
    rdfs:comment "Mono physically-modeled acoustic feedback and clean sustainer pedal. Features unpitched equal-power seamless loop hand-off, dynamic speaker distress, and RMS volume matching with smart note-tail sampling and Dev Tuner controls." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "trigger" ;
        lv2:name "Feedback / Expression" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "gain" ;
        lv2:name "Feedback Gain" ;
        lv2:default 75.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "distress" ;
        lv2:name "Speaker Distress" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "tail" ;
        lv2:name "Tail Decay" ;
        lv2:default 1.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 5.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "mix" ;
        lv2:name "Feedback Mix" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "takeover_thresh" ;
        lv2:name "Takeover Point" ;
        lv2:default 90.0 ;
        lv2:minimum 70.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "transition_time" ;
        lv2:name "Fade Time" ;
        lv2:default 350.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 1500.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "loop_window" ;
        lv2:name "Loop Window" ;
        lv2:default 80.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 400.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "loop_damping" ;
        lv2:name "Loop Damping" ;
        lv2:default 7500.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 18000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "vol_match" ;
        lv2:name "Volume Match" ;
        lv2:default 100.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 150.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "bloom_rate" ;
        lv2:name "Bloom Speed" ;
        lv2:default 0.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 3.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "attack_lockout" ;
        lv2:name "Attack Lockout" ;
        lv2:default 200.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 600.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 17 ;
        lv2:symbol "loop_attack" ;
        lv2:name "Loop Ingress Attack" ;
        lv2:default 40.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 200.0 ;
        units:unit units:ms ;
    ] .
