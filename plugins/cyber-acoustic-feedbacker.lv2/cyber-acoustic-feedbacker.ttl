@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://cyber-audio.co.uk/plugins/cyber-acoustic-feedbacker>
    a lv2:Plugin ,
      lv2:GeneratorPlugin ;
    doap:name "Cyber Acoustic Feedbacker" ;
    doap:license <http://opensource.org/licenses/mit> ;
    doap:developer [
        foaf:name "Cyber Audio" ;
        foaf:homepage <http://cyber-audio.co.uk> ;
    ] ;
    lv2:minorVersion 8 ;
    lv2:microVersion 0 ;
    mod:brand "CyberAudio" ;
    mod:label "Feedbacker" ;
    rdfs:comment "Physical electro-acoustic string feedback & clean sustainer. Closed-loop speaker distress recirculation, acoustic room simulation, trigger wiggle LFO, and hold-drone policy." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "trigger" ;
        lv2:name "Feedback / Expression" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "gain" ;
        lv2:name "Feedback Gain" ;
        lv2:default 75.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "distress" ;
        lv2:name "Speaker Distress" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "tail" ;
        lv2:name "Tail Decay" ;
        lv2:default 1.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 5.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "mix" ;
        lv2:name "Feedback Mix" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "takeover_thresh" ;
        lv2:name "Takeover Point" ;
        lv2:default 90.0 ;
        lv2:minimum 70.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "transition_time" ;
        lv2:name "Fade Ramp Time" ;
        lv2:default 500.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 20000.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "loop_window" ;
        lv2:name "String Window" ;
        lv2:default 120.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 500.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "loop_damping" ;
        lv2:name "String Damping" ;
        lv2:default 7500.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 18000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "vol_match" ;
        lv2:name "Volume Match" ;
        lv2:default 100.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 150.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "bloom_rate" ;
        lv2:name "Bloom Speed" ;
        lv2:default 0.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 5.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "attack_lockout" ;
        lv2:name "Attack Lockout" ;
        lv2:default 200.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 800.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 17 ;
        lv2:symbol "loop_attack" ;
        lv2:name "Ingress Attack Ramp" ;
        lv2:default 50.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 300.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 18 ;
        lv2:symbol "loop_release" ;
        lv2:name "Seam Splice Release" ;
        lv2:default 40.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 200.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 19 ;
        lv2:symbol "loop_drift" ;
        lv2:name "Phase Drift Diffusion" ;
        lv2:default 25.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 20 ;
        lv2:symbol "spk_recirc" ;
        lv2:name "Speaker Recirculation" ;
        lv2:default 60.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 21 ;
        lv2:symbol "pickup_sat" ;
        lv2:name "Pickup Saturation" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 22 ;
        lv2:symbol "air_wobble_rate" ;
        lv2:name "Air Wobble Rate" ;
        lv2:default 0.45 ;
        lv2:minimum 0.05 ;
        lv2:maximum 2.5 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 23 ;
        lv2:symbol "air_wobble_depth" ;
        lv2:name "Air Wobble Depth" ;
        lv2:default 15.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 50.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 24 ;
        lv2:symbol "room_in_loop" ;
        lv2:name "Room In Feedback Loop" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 25 ;
        lv2:symbol "room_size" ;
        lv2:name "Room Size" ;
        lv2:default 45.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 300.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 26 ;
        lv2:symbol "room_decay" ;
        lv2:name "Room Decay" ;
        lv2:default 0.8 ;
        lv2:minimum 0.1 ;
        lv2:maximum 3.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 27 ;
        lv2:symbol "room_damping" ;
        lv2:name "Room Damping" ;
        lv2:default 6500.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 16000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 28 ;
        lv2:symbol "room_mix" ;
        lv2:name "Room Output Mix" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 29 ;
        lv2:symbol "room_feed" ;
        lv2:name "Room Feedback Gain" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 30 ;
        lv2:symbol "trig_lfo_rate" ;
        lv2:name "Wiggle LFO Rate" ;
        lv2:default 0.60 ;
        lv2:minimum 0.05 ;
        lv2:maximum 5.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 31 ;
        lv2:symbol "trig_lfo_depth" ;
        lv2:name "Wiggle LFO Depth" ;
        lv2:default 20.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 50.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 32 ;
        lv2:symbol "hold_on_pluck" ;
        lv2:name "Hold Drone On Pluck" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] .
