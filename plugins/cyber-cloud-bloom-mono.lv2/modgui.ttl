@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-cloud-bloom-mono>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-cloud-bloom.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Cloud Bloom Mono" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "cyan" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "time" ;
            lv2:name "Time" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "feedback" ;
            lv2:name "Feedback" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "bloom" ;
            lv2:name "Bloom" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "smear" ;
            lv2:name "Smear" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "warmth" ;
            lv2:name "Warmth" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ]
    ] .
