@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-feedback-room-mono>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-feedback-room.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Feedback Room Mono" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#78350f" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "trigger" ;
            lv2:name "FEEDBACK" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "room_size" ;
            lv2:name "ROOM SIZE" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "room_decay" ;
            lv2:name "ROOM DECAY" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "room_damping" ;
            lv2:name "ROOM DAMP" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "room_feed" ;
            lv2:name "ROOM RECIRC" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "room_mix" ;
            lv2:name "ROOM MIX" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "room_in_loop" ;
            lv2:name "ROUTING" ;
        ] ;
    ] .
