@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://cyber-audio.co.uk/plugins/cyber-feedback-super>
    a lv2:Plugin ,
      lv2:GeneratorPlugin ;
    doap:name "Cyber Feedback Super" ;
    doap:license <http://opensource.org/licenses/mit> ;
    doap:developer [
        foaf:name "Cyber Audio" ;
        foaf:homepage <http://cyber-audio.co.uk> ;
    ] ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    mod:brand "CyberAudio" ;
    mod:label "Feedback Super" ;
    rdfs:comment "Clean zero-crossing micro-sampler boutique sustain & feedbacker with dev tuning matrix." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Audio In L" ;
    ] , [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Audio In R" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Audio Out L" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Audio Out R" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback / Expression" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "sustain_level" ;
        lv2:name "Sustain Level" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.5 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "crossfade_ms" ;
        lv2:name "Crossfade Time" ;
        lv2:default 20.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 100.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "loop_len_min" ;
        lv2:name "Min Loop Length" ;
        lv2:default 30.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 80.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "loop_nudge" ;
        lv2:name "Loop Nudge" ;
        lv2:default 0.0 ;
        lv2:minimum -50.0 ;
        lv2:maximum 50.0 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "release_ms" ;
        lv2:name "Release Time" ;
        lv2:default 400.0 ;
        lv2:minimum 50.0 ;
        lv2:maximum 3000.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "waver_depth" ;
        lv2:name "Waver Depth" ;
        lv2:default 1.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "waver_rate" ;
        lv2:name "Waver Rate" ;
        lv2:default 1.2 ;
        lv2:minimum 0.1 ;
        lv2:maximum 8.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "speaker_distress" ;
        lv2:name "Speaker Distress" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "room_in_loop" ;
        lv2:name "Room Routing" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 15 ;
        lv2:symbol "room_size" ;
        lv2:name "Room Size" ;
        lv2:default 180.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 300.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 16 ;
        lv2:symbol "room_decay" ;
        lv2:name "Room Decay" ;
        lv2:default 2.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 3.0 ;
        units:unit units:s ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 17 ;
        lv2:symbol "room_mix" ;
        lv2:name "Room Mix" ;
        lv2:default 25.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] .
