@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .

<http://cyber-audio.co.uk/plugins/cyber-feedback-super>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-feedback-super.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Feedback Super" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "#0f172a" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "feedback" ;
            lv2:name "FEEDBACK" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "sustain_level" ;
            lv2:name "SUSTAIN" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "crossfade_ms" ;
            lv2:name "CROSSFADE" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "loop_len_min" ;
            lv2:name "MIN LOOP" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "loop_nudge" ;
            lv2:name "NUDGE" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "release_ms" ;
            lv2:name "RELEASE" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "waver_depth" ;
            lv2:name "WAVER DEPTH" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "waver_rate" ;
            lv2:name "WAVER RATE" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "speaker_distress" ;
            lv2:name "DISTRESS" ;
        ] , [
            lv2:index 9 ;
            lv2:symbol "room_size" ;
            lv2:name "ROOM SIZE" ;
        ] , [
            lv2:index 10 ;
            lv2:symbol "room_decay" ;
            lv2:name "ROOM DECAY" ;
        ] , [
            lv2:index 11 ;
            lv2:symbol "room_mix" ;
            lv2:name "ROOM MIX" ;
        ] , [
            lv2:index 12 ;
            lv2:symbol "room_in_loop" ;
            lv2:name "ROUTING" ;
        ] ;
    ] .
