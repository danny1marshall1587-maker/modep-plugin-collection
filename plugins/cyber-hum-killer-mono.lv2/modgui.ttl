@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://moddevices.com/plugins/danny/cyber-hum-killer-mono>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-hum-killer.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Hum Killer Mono" ;
        modgui:model "boxy" ;
        modgui:panel "custom" ;
        modgui:color "black" ;
        modgui:knob "amber" ;
        modgui:monitoredOutputs [ lv2:symbol "learning_status" ] ,
                                [ lv2:symbol "l1" ] , [ lv2:symbol "l2" ] , [ lv2:symbol "l3" ] , [ lv2:symbol "l4" ] ,
                                [ lv2:symbol "l5" ] , [ lv2:symbol "l6" ] , [ lv2:symbol "l7" ] , [ lv2:symbol "l8" ] ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "t1" ;
            lv2:name "DC/Sub" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "t2" ;
            lv2:name "Funda" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "t3" ;
            lv2:name "2nd" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "t4" ;
            lv2:name "3rd" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "t5" ;
            lv2:name "Mids" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "t6" ;
            lv2:name "MidBuzz" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "t7" ;
            lv2:name "HiBuzz" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "t8" ;
            lv2:name "EMI" ;
        ]
    ] .
