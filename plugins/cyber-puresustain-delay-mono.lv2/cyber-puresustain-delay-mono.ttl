@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod: <http://moddevices.com/ns/mod#> .

<http://cyber-audio.co.uk/plugins/cyber-puresustain-delay-mono>
    a lv2:Plugin ,
      lv2:DelayPlugin ;
    doap:name "Cyber PureSustain Delay Mono" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "Cyber Audio" ;
    mod:label "PureSustain Mono" ;
    rdfs:comment "Mono boutique seamless crossfade pad delay with Cytomic SVF tail filtering, Hermite interpolation, and dynamic picking ducker." ;

    lv2:port [
        a lv2:AudioPort , lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "Audio In" ;
    ] , [
        a lv2:AudioPort , lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Audio Out" ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "time" ;
        lv2:name "Delay Time" ;
        lv2:default 400.0 ;
        lv2:minimum 10.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 45.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 115.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "melt" ;
        lv2:name "Melt Sustainer" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "tone" ;
        lv2:name "Tape Tone" ;
        lv2:default 60.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "duck" ;
        lv2:name "Ducker Depth" ;
        lv2:default 30.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "mix" ;
        lv2:name "Dry/Wet Mix" ;
        lv2:default 40.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "mod_on" ;
        lv2:name "Modulation On" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "mod_depth" ;
        lv2:name "Mod Depth" ;
        lv2:default 3.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 15.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "mod_rate" ;
        lv2:name "Mod Rate" ;
        lv2:default 1.2 ;
        lv2:minimum 0.1 ;
        lv2:maximum 8.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "hp_freq" ;
        lv2:name "Low Cut HPF" ;
        lv2:default 80.0 ;
        lv2:minimum 20.0 ;
        lv2:maximum 2000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "lp_freq" ;
        lv2:name "High Cut LPF" ;
        lv2:default 8000.0 ;
        lv2:minimum 1000.0 ;
        lv2:maximum 20000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort , lv2:InputPort ;
        lv2:index 14 ;
        lv2:symbol "filter_q" ;
        lv2:name "Filter Q" ;
        lv2:default 0.707 ;
        lv2:minimum 0.5 ;
        lv2:maximum 4.0 ;
    ] .
