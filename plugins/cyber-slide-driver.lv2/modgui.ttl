@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://cyber-audio.co.uk/plugins/cyber-slide-driver>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-cyber-slide-driver.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:javascript <modgui/script.js> ;
        modgui:brand "Cyber Audio" ;
        modgui:label "Slide Driver" ;
        modgui:model "boxy" ;
        modgui:panel "3-row" ;
        modgui:color "bronze" ;
        modgui:knob "gold" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "comp_a" ;
            lv2:name "Comp A" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "comp_b" ;
            lv2:name "Comp B" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "drive" ;
            lv2:name "Drive" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "clean" ;
            lv2:name "Clean" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "tone" ;
            lv2:name "Tone" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "de_ice" ;
            lv2:name "De-Ice" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "mid_boost" ;
            lv2:name "Mids" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "bass_tight" ;
            lv2:name "Tight" ;
        ] , [
            lv2:index 8 ;
            lv2:symbol "output" ;
            lv2:name "Level" ;
        ]
    ] .
