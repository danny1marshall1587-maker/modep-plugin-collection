@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<http://moddevices.com/plugins/danny/dimension-c>
    a lv2:Plugin ,
      lv2:ChorusPlugin ;
    doap:name "Dimension-C Spatial Chorus" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "Dimension-C" ;
    rdfs:comment "Authentic analog BBD spatial chorus modeled after the legendary Boss DC-2 Dimension C & Roland SDD-320 Dimension D with 180-degree anti-phase modulation, 4 iconic pushbutton modes, and SDD-320 All-Buttons secret mode." ;
    
    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In Left" ;
    ] , [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In Right" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out Left" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out Right" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "mode" ;
        lv2:name "Dimension Mode" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 5 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [
            rdfs:label "Manual (Custom)" ;
            rdf:value 0
        ] , [
            rdfs:label "Mode I (Subtle Width)" ;
            rdf:value 1
        ] , [
            rdfs:label "Mode II (Lush Clean)" ;
            rdf:value 2
        ] , [
            rdfs:label "Mode III (Deep Dimension)" ;
            rdf:value 3
        ] , [
            rdfs:label "Mode IV (Intense Spatial)" ;
            rdf:value 4
        ] , [
            rdfs:label "All Buttons (SDD-320 Secret Mode)" ;
            rdf:value 5
        ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "width" ;
        lv2:name "Stereo Width" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 2.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 100.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "rate" ;
        lv2:name "Manual Rate" ;
        lv2:default 0.5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 5.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "depth" ;
        lv2:name "Manual Depth" ;
        lv2:default 0.65 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "color" ;
        lv2:name "BBD Warmth" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] .
