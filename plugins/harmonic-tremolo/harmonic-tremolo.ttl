@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .

<http://moddevices.com/plugins/danny/harmonic-tremolo>
    a lv2:Plugin ,
      lv2:ModulatorPlugin ;
    doap:name "Harmonic Tremolo" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "Harmonic Trem" ;
    rdfs:comment "Vintage Fender Tri-Verb / Brownface style Harmonic Tremolo with Cytomic State Variable Filter crossover, dual anti-phase LFO modulation, and asymmetric tube warmth modeling." ;
    
    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "In Left" ;
    ] , [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "In Right" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Out Left" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Out Right" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "rate" ;
        lv2:name "Rate" ;
        lv2:default 3.5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 20.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "depth" ;
        lv2:name "Depth" ;
        lv2:default 0.85 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "crossover" ;
        lv2:name "Crossover" ;
        lv2:default 650.0 ;
        lv2:minimum 150.0 ;
        lv2:maximum 4000.0 ;
        units:unit units:hz ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "warmth" ;
        lv2:name "Warmth" ;
        lv2:default 0.35 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "waveform" ;
        lv2:name "Waveform" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 3 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [
            rdfs:label "Sine" ;
            rdf:value 0
        ] , [
            rdfs:label "Triangle" ;
            rdf:value 1
        ] , [
            rdfs:label "Tube-Sine" ;
            rdf:value 2
        ] , [
            rdfs:label "Square" ;
            rdf:value 3
        ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "stereo_phase" ;
        lv2:name "Stereo Phase" ;
        lv2:default 90.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 180.0 ;
        units:unit units:degree ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "mix" ;
        lv2:name "Mix" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "resonance" ;
        lv2:name "Resonance Q" ;
        lv2:default 0.707 ;
        lv2:minimum 0.5 ;
        lv2:maximum 5.0 ;
    ] .
