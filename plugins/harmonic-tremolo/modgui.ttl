@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://moddevices.com/plugins/danny/harmonic-tremolo>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-harmonic-tremolo.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "Harmonic Trem" ;
        modgui:model "boxy" ;
        modgui:panel "6-knobs" ;
        modgui:color "bronze" ;
        modgui:knob "cream" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "rate" ;
            lv2:name "Rate" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "depth" ;
            lv2:name "Depth" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "crossover" ;
            lv2:name "X-Over" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "warmth" ;
            lv2:name "Warmth" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "waveform" ;
            lv2:name "Wave" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "mix" ;
            lv2:name "Mix" ;
        ] ;
    ] .
