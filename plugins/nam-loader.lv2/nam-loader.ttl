@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix mod:   <http://moddevices.com/ns/mod#> .

<http://moddevices.com/plugins/danny/nam-loader>
    a lv2:Plugin ,
      lv2:SimulatorPlugin ;
    doap:name "Neural Amp Modeler (Tone 3000 / NAM Loader)" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "NAM Loader" ;
    rdfs:comment "Neural Amp Modeler (NAM) profile & Tone 3000 loader with 12 built-in world-class amp/pedal captures, 3-band tonestack, noise gate, and speaker cabinet simulation." ;

    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 2 ;
        lv2:symbol "bypass" ;
        lv2:name "Bypass" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
        lv2:designation lv2:enabled ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 3 ;
        lv2:symbol "profile" ;
        lv2:name "NAM Model" ;
        lv2:default 4 ;
        lv2:minimum 0 ;
        lv2:maximum 11 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [
            rdfs:label "Fender '65 Deluxe (Clean)" ;
            rdf:value 0
        ] , [
            rdfs:label "Vox AC30 Top Boost (Chime)" ;
            rdf:value 1
        ] , [
            rdfs:label "Marshall Bluesbreaker (Edge)" ;
            rdf:value 2
        ] , [
            rdfs:label "Dumble ODS Crunch (Boutique)" ;
            rdf:value 3
        ] , [
            rdfs:label "Marshall JCM800 2203 (Rock)" ;
            rdf:value 4
        ] , [
            rdfs:label "Soldano SLO-100 (Lead)" ;
            rdf:value 5
        ] , [
            rdfs:label "Peavey 5150 Block (Metal)" ;
            rdf:value 6
        ] , [
            rdfs:label "Mesa Dual Rectifier (High Gain)" ;
            rdf:value 7
        ] , [
            rdfs:label "Friedman BE-100 (Boutique Lead)" ;
            rdf:value 8
        ] , [
            rdfs:label "Ampeg SVT-CL (Tube Bass)" ;
            rdf:value 9
        ] , [
            rdfs:label "Klon Centaur (Transparent OD)" ;
            rdf:value 10
        ] , [
            rdfs:label "TS808 Tube Screamer (Mid Boost)" ;
            rdf:value 11
        ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 4 ;
        lv2:symbol "drive" ;
        lv2:name "Gain" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "bass" ;
        lv2:name "Bass" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "mid" ;
        lv2:name "Mid" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "treble" ;
        lv2:name "Treble" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "volume" ;
        lv2:name "Master" ;
        lv2:default 0.5 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "gate" ;
        lv2:name "Noise Gate" ;
        lv2:default -80.0 ;
        lv2:minimum -80.0 ;
        lv2:maximum 0.0 ;
        units:unit units:db ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "cab_enable" ;
        lv2:name "Cab IR" ;
        lv2:default 1.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] .
