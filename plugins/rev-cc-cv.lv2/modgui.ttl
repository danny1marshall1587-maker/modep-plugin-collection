@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<http://moddevices.com/plugins/danny/rev-cc-cv>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-rev-cc-cv.html> ;
        modgui:stylesheet <modgui/stylesheet.css> ;
        modgui:javascript <modgui/script.js> ;
        modgui:screenshot <modgui/screenshot.png> ;
        modgui:thumbnail <modgui/thumbnail.png> ;
        modgui:brand "CyberAudio" ;
        modgui:label "REVCC/CV" ;
        modgui:model "boxy" ;
        modgui:panel "1-column" ;
        modgui:color "black" ;
        modgui:port [
            lv2:index 0 ;
            lv2:symbol "direction" ;
            lv2:name "REV MODE" ;
        ] , [
            lv2:index 1 ;
            lv2:symbol "level" ;
            lv2:name "LEVEL" ;
        ] , [
            lv2:index 2 ;
            lv2:symbol "cc_num" ;
            lv2:name "CC #" ;
        ] , [
            lv2:index 3 ;
            lv2:symbol "min_volts" ;
            lv2:name "MIN V" ;
        ] , [
            lv2:index 4 ;
            lv2:symbol "max_volts" ;
            lv2:name "MAX V" ;
        ] , [
            lv2:index 5 ;
            lv2:symbol "curve" ;
            lv2:name "CURVE" ;
        ] , [
            lv2:index 6 ;
            lv2:symbol "smoothing" ;
            lv2:name "GLIDE" ;
        ] , [
            lv2:index 7 ;
            lv2:symbol "offset" ;
            lv2:name "OFFSET" ;
        ] ;
    ] .
