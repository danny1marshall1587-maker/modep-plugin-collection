@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<http://moddevices.com/plugins/danny/rev-cc-cv>
    a lv2:Plugin ,
      mod:ControlVoltagePlugin ;
    doap:name "REV CC/CV (Reverse Expression & CC to Voltage)" ;
    doap:license <http://opensource.org/licenses/mit> ;
    mod:brand "CyberAudio" ;
    mod:label "REVCC/CV" ;
    rdfs:comment "Advanced MIDI CC and manual control to CV voltage generator featuring instant Reverse Direction mode, dual inverted and bipolar outputs, response curve shaping, and anti-zipper glide." ;

    lv2:port [
        a atom:AtomPort ,
          lv2:InputPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 0 ;
        lv2:symbol "midi_in" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:CVPort ,
          mod:CVPort ,
          lv2:OutputPort ;
        lv2:index 1 ;
        lv2:symbol "cv_out_main" ;
        lv2:name "CV Out (Switched)" ;
    ] , [
        a lv2:CVPort ,
          mod:CVPort ,
          lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "cv_out_rev" ;
        lv2:name "CV Out (Inverted)" ;
    ] , [
        a lv2:CVPort ,
          mod:CVPort ,
          lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "cv_out_bipolar" ;
        lv2:name "CV Out (-5V to +5V)" ;
    ] , [
        a lv2:CVPort ,
          mod:CVPort ,
          lv2:OutputPort ;
        lv2:index 4 ;
        lv2:symbol "cv_out_norm" ;
        lv2:name "CV Out (0.0 to 1.0)" ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 5 ;
        lv2:symbol "direction" ;
        lv2:name "Reverse Mode" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0 ;
        lv2:portProperty lv2:toggled , lv2:integer ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 6 ;
        lv2:symbol "level" ;
        lv2:name "Expression Level" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 7 ;
        lv2:symbol "cc_num" ;
        lv2:name "MIDI CC #" ;
        lv2:default 7.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 127.0 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "midi_ch" ;
        lv2:name "MIDI Channel" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 16.0 ;
        lv2:portProperty lv2:integer ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 9 ;
        lv2:symbol "min_volts" ;
        lv2:name "Min Volts" ;
        lv2:default 0.0 ;
        lv2:minimum -10.0 ;
        lv2:maximum 10.0 ;
        units:unit units:v ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 10 ;
        lv2:symbol "max_volts" ;
        lv2:name "Max Volts" ;
        lv2:default 10.0 ;
        lv2:minimum -10.0 ;
        lv2:maximum 10.0 ;
        units:unit units:v ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 11 ;
        lv2:symbol "curve" ;
        lv2:name "Taper Curve" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 3.0 ;
        lv2:portProperty lv2:enumeration , lv2:integer ;
        lv2:scalePoint [ rdfs:label "Linear" ; rdf:value 0.0 ] ;
        lv2:scalePoint [ rdfs:label "Logarithmic" ; rdf:value 1.0 ] ;
        lv2:scalePoint [ rdfs:label "Anti-Log (Exp)" ; rdf:value 2.0 ] ;
        lv2:scalePoint [ rdfs:label "S-Curve" ; rdf:value 3.0 ] ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 12 ;
        lv2:symbol "smoothing" ;
        lv2:name "Glide / Smooth" ;
        lv2:default 10.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 200.0 ;
        units:unit units:ms ;
    ] , [
        a lv2:ControlPort ,
          lv2:InputPort ;
        lv2:index 13 ;
        lv2:symbol "offset" ;
        lv2:name "Volt Offset" ;
        lv2:default 0.0 ;
        lv2:minimum -5.0 ;
        lv2:maximum 5.0 ;
        units:unit units:v ;
    ] .
